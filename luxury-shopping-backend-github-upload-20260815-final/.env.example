DATABASE_URL=postgresql+asyncpg://USERNAME:PASSWORD@NEON_HOST/DATABASE_NAME
DATABASE_MIGRATION_URL=
APP_ENV=development
ALLOW_TEST_FIXTURES=false
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=30
UPLOAD_DIR=backend/data/uploads
STORAGE_PROVIDER=local
RENDER_PUBLIC_URL=https://luxury-backend-xy9d.onrender.com
R2_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=luxury-images-prod
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_PUBLIC_BASE_URL=https://images.luxuryshoppings.com
BACKUP_ENCRYPTION_KEY=
# In staging/production, encrypted backups reuse the configured R2 bucket
# under the luxury-secure-backups/ prefix unless BACKUP_S3_* is supplied.
BACKUP_OFFSITE_PROVIDER=filesystem
BACKUP_S3_ENDPOINT_URL=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=auto
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
API_BASE_URL=https://api.luxuryshoppings.com
APP_PUBLIC_URL=https://api.luxuryshoppings.com
FRONTEND_PUBLIC_URL=https://luxuryshoppings.com
WS_BASE_URL=wss://api.luxuryshoppings.com
CORS_ORIGINS=https://luxuryshoppings.com,https://www.luxuryshoppings.com
REALTIME_ALLOWED_ORIGINS=https://luxuryshoppings.com,https://www.luxuryshoppings.com
MAX_UPLOAD_BYTES=10485760
LOGIN_RATE_LIMIT=8
PASSWORD_RESET_RATE_LIMIT=4
# Production verification codes are delivered through the verified
# luxuryshoppings.com sending domain in Resend. Do not use a personal Gmail
# mailbox as a fallback because delivery to new recipients is not reliable.
EMAIL_PROVIDER=resend
RESEND_API_URL=https://api.resend.com/emails
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@luxuryshoppings.com
# Local-only fallback, when explicitly requested with EMAIL_PROVIDER=smtp.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
PUBLIC_READ_CACHE_TTL_SECONDS=30
WHATSAPP_PROVIDER_URL=
WHATSAPP_ACCESS_TOKEN=
AI_API_URL=
AI_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
AI_PROVIDER_NAME=gemini
AI_DEFAULT_MODEL=gemini-2.0-flash
AI_MODEL_ALLOWLIST=gemini-2.0-flash
IMAGE_AI_ENHANCEMENT_ENABLED=true
IMAGE_AI_MODEL=gemini-2.5-flash-image
IMAGE_AI_TIMEOUT_SECONDS=30
IMAGE_AI_MAX_INPUT_BYTES=5242880
IMAGE_MAX_DIMENSION=2400
IMAGE_MIN_DIMENSION=900
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_APPLICATION_CREDENTIALS_JSON=
FIREBASE_SERVICE_ACCOUNT_JSON=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
